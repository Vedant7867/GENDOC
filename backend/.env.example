# Copy to backend/.env (never commit the real file). Used by `uvicorn` and by docker compose.
MONGO_URI=mongodb://localhost:27017
DB_NAME=gendoc
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173

# AI (optional). Without a key everything except extraction, drafting, free-form and the editor Copilot still works.
GENDOC_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Leave empty for the default model (gemini-2.5-flash); set it if Google retires or renames a model.
GENDOC_LLM_MODEL=
